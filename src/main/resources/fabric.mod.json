{
  "schemaVersion": 1,
  "id": "auto-login-mod",
  "version": "2.1.3",
  "name": "Cytech Auto Login",
  "description": "Client-side automatic authentication for Minecraft servers using /login or /register, with prompt detection, per-server credentials, encrypted storage, and optional remembered device unlock.",
  "authors": [
    "Cytech Team",
    "namnarak"
  ],
  "contact": {
    "homepage": "https://github.com/CyoriaSMP-Team/Cytech-Auto-Login",
    "sources": "https://github.com/CyoriaSMP-Team/Cytech-Auto-Login",
    "issues": "https://github.com/CyoriaSMP-Team/Cytech-Auto-Login/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/auto-login-mod/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cloud.sect.alm.AutoLoginModClient"
    ],
    "modmenu": [
      "cloud.sect.alm.integration.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "custom": {
    "cytech_auto_login:metadata": {
      "schema_version": 1,
      "project": {
        "name": "Cytech Auto Login",
        "slug": "cytechautologin",
        "type": "minecraft-mod",
        "side": "client",
        "maintainer": "Cytech Team",
        "website": "https://github.com/CyoriaSMP-Team/Cytech-Auto-Login",
        "source": "https://github.com/CyoriaSMP-Team/Cytech-Auto-Login",
        "issues": "https://github.com/CyoriaSMP-Team/Cytech-Auto-Login/issues",
        "modrinth": "https://modrinth.com/project/cytechautologin"
      },
      "compatibility": {
        "loaders": [
          "fabric"
        ],
        "minecraft_versions": [
          "1.21.11"
        ],
        "java_versions": [
          21
        ],
        "required_dependencies": [
          "fabric-api"
        ]
      },
      "classification": {
        "categories": [
          "utility",
          "authentication",
          "quality-of-life"
        ],
        "tags": [
          "auto-login",
          "authentication",
          "client-side",
          "fabric"
        ]
      },
      "capabilities": [
        "prompt-detection",
        "automatic-login",
        "automatic-registration",
        "per-server-credentials",
        "encrypted-credential-storage",
        "optional-master-password",
        "remembered-device-unlock",
        "thai-and-english-prompt-detection"
      ],
      "security": {
        "credential_encryption": "AES-GCM",
        "key_derivation": "PBKDF2-HMAC-SHA256",
        "master_password": "optional",
        "remembered_unlock": "optional-device-local-convenience",
        "local_device_key_path": "config/alm-device.key",
        "warning": "Anyone with full access to the Minecraft config directory may be able to access both the encrypted credentials and the local device key."
      }
    }
  }
}
